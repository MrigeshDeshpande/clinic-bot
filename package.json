{
  "name": "clinic-bot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:replay": "REPLAY_MODE=true node --experimental-loader ./tests/replay/path-loader.js tests/replay/runner.js",
